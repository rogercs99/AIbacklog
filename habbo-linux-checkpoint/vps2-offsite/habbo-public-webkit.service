[Unit]
Description=Habbo public WebKit iPhone regression smoke
After=network-online.target
Wants=network-online.target
OnFailure=habbo-public-webkit-failed.service

[Service]
Type=oneshot
Environment=PLAYWRIGHT_BROWSERS_PATH=/root/.cache/ms-playwright
ExecStart=/usr/local/sbin/habbo-public-webkit-daily.sh
TimeoutStartSec=120
