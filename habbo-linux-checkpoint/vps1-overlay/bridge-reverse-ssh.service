[Unit]
Description=Persistent reverse SSH route to bridge-new
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/ssh -N -T -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=accept-new -R 127.0.0.1:22022:127.0.0.1:22 bridge-new
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target