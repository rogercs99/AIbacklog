[Site]
site.directory=/var/www/html

[Global]
bind.ip=127.0.0.1
bind.port=80

[Rcon]
rcon.ip=127.0.0.1
rcon.port=12309

[Database]
mysql.hostname=127.0.0.1
mysql.port=3306
mysql.username=havana
mysql.password=<LOCAL_THROWAWAY_PASSWORD>
mysql.database=havana

[Template]
template.directory=tools/www-tpl
template.name=default
template.locale.file=locale-en.ini

page.encoding=utf-8
